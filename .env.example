# Copy this file to .env for local development.
# In production (Databricks Apps), these come from app.yaml + secret scopes.

# Lakebase Postgres connection URL (only for local testing without Databricks CLI)
# LAKEBASE_URL=postgresql://user:password@host:5432/databricks_postgres?sslmode=require

# Databricks secret scope + key that hold the Lakebase URL in production
LAKEBASE_SECRET_SCOPE=database
LAKEBASE_SECRET_KEY=lakebase-url

# Wikipedia asks for a descriptive User-Agent with a contact email
WIKIPEDIA_USER_AGENT="RoamAI/1.0 (rajendrannpriyankaa24@gmail.com)"
